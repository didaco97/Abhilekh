{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/chat.js": { "maxDuration": 60 }, "api/voice.js": { "maxDuration": 60 } },
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=(self)" }] }]
}
